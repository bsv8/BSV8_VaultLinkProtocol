{
  "suite": "frame",
  "version": "0.1",
  "limits": {
    "maxFramePayload": 1024,
    "maxMessage": 896,
    "receiveBufferBytes": 1039
  },
  "cases": [
    {
      "id": "frame-basic",
      "description": "基本帧编码：magic/version/type/flags/seq/len/crc",
      "bytes": "a55a011001070000001100766c702d6672616d652d7061796c6f6164dc56187a",
      "fields": {
        "magic": "a55a",
        "version": 1,
        "type": 16,
        "flags": 1,
        "seq": 7,
        "payloadLen": 17,
        "payload": "766c702d6672616d652d7061796c6f6164",
        "frameLen": 32
      }
    },
    {
      "id": "frame-max-payload",
      "description": "恰好 MAX_FRAME_PAYLOAD 必须被接受（0002 §2 S2：现有实现实际只能 1522）",
      "bytes": "",
      "fields": {
        "payloadLen": 1024,
        "frameLen": 1039
      }
    },
    {
      "id": "frame-aad",
      "description": "AAD 10 字节，整数大端（spec/core/03-帧与消息.md §4.1）",
      "bytes": "100101020304aabbccdd",
      "fields": {
        "length": 10
      }
    },
    {
      "id": "frame-crc32-checkvalue",
      "description": "CRC-32/ISO-HDLC 校验值；magic 不计入 CRC",
      "crcOfAscii123456789": "cbf43926",
      "crcOfEmpty": "00000000"
    }
  ],
  "negativeCases": [
    {
      "id": "frame-neg-magic",
      "description": "magic 错误 → 重同步并丢弃",
      "bytes": "a55b011001070000001100766c702d6672616d652d7061796c6f6164dc56187a",
      "expectError": "bad-magic"
    },
    {
      "id": "frame-neg-version",
      "description": "version != 1 → 丢弃，不降级",
      "bytes": "a55a021001070000001100766c702d6672616d652d7061796c6f6164dc56187a",
      "expectError": "bad-version"
    },
    {
      "id": "frame-neg-crc",
      "description": "CRC 不符 → 丢弃",
      "bytes": "a55a011001070000001100766c702d6672616d652d7061796c6f6164dc561885",
      "expectError": "crc-mismatch"
    },
    {
      "id": "frame-neg-oversize-header-only",
      "description": "payloadLen > 上限：仅凭头即拒绝，不等负载",
      "bytes": "a55a01100000000000ffff",
      "expectError": "payload-length-out-of-range"
    },
    {
      "id": "frame-neg-reserved-flags",
      "description": "保留标志位非零 → 拒绝",
      "bytes": "a55a01100001000000000063e29546",
      "flagsOverride": 8,
      "expectError": "reserved-flag-bits-set"
    }
  ]
}
